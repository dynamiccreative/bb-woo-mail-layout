#: src/Email/DefaultTexts.php:28
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Votre commande n° {order_number} a été partiellement remboursée. Le montant sera crédité sur votre moyen de paiement d’origine dans les prochains jours."
msgstr ""

#: src/Email/DefaultTexts.php:33
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Le paiement de votre commande n° {order_number} du {order_date} n’a pas abouti. Vous pouvez le relancer à tout moment grâce au bouton ci-dessous."
msgstr ""

#: src/Email/DefaultTexts.php:34
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Une commande a été créée pour vous sur {site_title}. Vous en trouverez le détail ci-dessous, ainsi qu’un lien pour la régler quand vous le souhaitez."
msgstr ""

#: src/Email/DefaultTexts.php:52
msgid ""
"Vous avez reçu une nouvelle commande de {customer_first_name} {customer_last_name}.\n"
"\n"
"Commande n° {order_number} du {order_date}, d’un montant de {order_total}. {order_url}"
msgstr ""

#: src/Email/DefaultTexts.php:53
msgid "La commande n° {order_number} de {customer_first_name} {customer_last_name} a été annulée. {order_url}"
msgstr ""

#: src/Email/DefaultTexts.php:54
msgid "Le paiement de la commande n° {order_number} de {customer_first_name} {customer_last_name} a échoué. La commande est en attente de paiement. {order_url}"
msgstr ""

#: src/Email/DefaultTexts.php:55
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Nous avons bien reçu votre commande n° {order_number}. Elle est en attente jusqu’à la confirmation de votre paiement. Vous en trouverez le récapitulatif ci-dessous."
msgstr ""

#: src/Email/DefaultTexts.php:56
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Merci pour votre commande ! Nous avons bien reçu votre commande n° {order_number} et nous la préparons dès maintenant. Vous en trouverez le récapitulatif ci-dessous."
msgstr ""

#: src/Email/DefaultTexts.php:57
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Bonne nouvelle : votre commande n° {order_number} est terminée. Si elle doit vous être livrée, elle est désormais en route. {tracking_url}\n"
"\n"
"Merci pour votre confiance !"
msgstr ""

#: src/Email/DefaultTexts.php:58
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Votre commande n° {order_number} a été annulée. S’il s’agit d’une erreur, n’hésitez pas à nous contacter."
msgstr ""

#: src/Email/DefaultTexts.php:59
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Le paiement de votre commande n° {order_number} n’a malheureusement pas abouti. Vous pouvez réessayer depuis votre espace client ou nous contacter si le problème persiste."
msgstr ""

#: src/Email/DefaultTexts.php:60
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Votre commande n° {order_number} a été remboursée. Le montant sera crédité sur votre moyen de paiement d’origine dans les prochains jours."
msgstr ""

#: src/Email/DefaultTexts.php:61
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Une note a été ajoutée à votre commande n° {order_number} :"
msgstr ""

#: src/Email/DefaultTexts.php:62

#: src/Email/DefaultTexts.php:28
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Votre commande n° {order_number} a été partiellement remboursée. Le montant sera crédité sur votre moyen de paiement d’origine dans les prochains jours."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"Your order #{order_number} has been partially refunded. The amount will be credited to your original payment method within the next few days."

#: src/Email/DefaultTexts.php:33
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Le paiement de votre commande n° {order_number} du {order_date} n’a pas abouti. Vous pouvez le relancer à tout moment grâce au bouton ci-dessous."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"The payment for your order #{order_number} of {order_date} did not go through. You can retry it at any time using the button below."

#: src/Email/DefaultTexts.php:34
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Une commande a été créée pour vous sur {site_title}. Vous en trouverez le détail ci-dessous, ainsi qu’un lien pour la régler quand vous le souhaitez."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"An order has been created for you on {site_title}. You will find the details below, along with a link to pay for it whenever you are ready."

#: src/Email/DefaultTexts.php:52
msgid ""
"Vous avez reçu une nouvelle commande de {customer_first_name} {customer_last_name}.\n"
"\n"
"Commande n° {order_number} du {order_date}, d’un montant de {order_total}. {order_url}"
msgstr ""
"You have received a new order from {customer_first_name} {customer_last_name}.\n"
"\n"
"Order #{order_number} of {order_date}, totalling {order_total}. {order_url}"

#: src/Email/DefaultTexts.php:53
msgid "La commande n° {order_number} de {customer_first_name} {customer_last_name} a été annulée. {order_url}"
msgstr "Order #{order_number} from {customer_first_name} {customer_last_name} has been cancelled. {order_url}"

#: src/Email/DefaultTexts.php:54
msgid "Le paiement de la commande n° {order_number} de {customer_first_name} {customer_last_name} a échoué. La commande est en attente de paiement. {order_url}"
msgstr "Payment for order #{order_number} from {customer_first_name} {customer_last_name} has failed. The order is awaiting payment. {order_url}"

#: src/Email/DefaultTexts.php:55
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Nous avons bien reçu votre commande n° {order_number}. Elle est en attente jusqu’à la confirmation de votre paiement. Vous en trouverez le récapitulatif ci-dessous."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"We have received your order #{order_number}. It is on hold until your payment is confirmed. You will find a summary below."

#: src/Email/DefaultTexts.php:56
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Merci pour votre commande ! Nous avons bien reçu votre commande n° {order_number} et nous la préparons dès maintenant. Vous en trouverez le récapitulatif ci-dessous."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"Thank you for your order! We have received your order #{order_number} and are preparing it now. You will find a summary below."

#: src/Email/DefaultTexts.php:57
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Bonne nouvelle : votre commande n° {order_number} est terminée. Si elle doit vous être livrée, elle est désormais en route. {tracking_url}\n"
"\n"
"Merci pour votre confiance !"
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"Good news: your order #{order_number} is complete. If it is being delivered, it is now on its way. {tracking_url}\n"
"\n"
"Thank you for your trust!"

#: src/Email/DefaultTexts.php:58
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Votre commande n° {order_number} a été annulée. S’il s’agit d’une erreur, n’hésitez pas à nous contacter."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"Your order #{order_number} has been cancelled. If this is a mistake, please do not hesitate to contact us."

#: src/Email/DefaultTexts.php:59
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Le paiement de votre commande n° {order_number} n’a malheureusement pas abouti. Vous pouvez réessayer depuis votre espace client ou nous contacter si le problème persiste."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"Unfortunately, the payment for your order #{order_number} did not go through. You can try again from your account or contact us if the problem persists."

#: src/Email/DefaultTexts.php:60
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Votre commande n° {order_number} a été remboursée. Le montant sera crédité sur votre moyen de paiement d’origine dans les prochains jours."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"Your order #{order_number} has been refunded. The amount will be credited to your original payment method within the next few days."

#: src/Email/DefaultTexts.php:61
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Une note a été ajoutée à votre commande n° {order_number} :"
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"A note has been added to your order #{order_number}:"

#: src/Email/DefaultTexts.php:62
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Voici le détail de votre commande n° {order_number} passée le {order_date}."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"Here are the details of your order #{order_number} placed on {order_date}."

#: src/Email/DefaultTexts.php:63
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Merci d’avoir créé votre compte sur {site_title}. Depuis votre espace client, vous pouvez suivre vos commandes et gérer vos informations personnelles."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"Thank you for creating your account on {site_title}. From your account, you can track your orders and manage your personal details."

#: src/Email/DefaultTexts.php:64
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Nous avons reçu une demande de réinitialisation du mot de passe de votre compte sur {site_title}. Si vous n’êtes pas à l’origine de cette demande, ignorez simplement cet e-mail : votre mot de passe restera inchangé."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"We received a request to reset the password of your account on {site_title}. If you did not make this request, simply ignore this email: your password will remain unchanged."

#: src/Email/DefaultTexts.php:75
msgid ""
"Bonjour {customer_first_name},\n"
"\n"
"Vous trouverez ci-dessous les informations concernant : « {email_title} »."
msgstr ""
"Hello {customer_first_name},\n"
"\n"
"Please find below the information regarding: “{email_title}”."

#: src/Email/DefaultTexts.php:76
msgid "Notification de la boutique {site_title} : « {email_title} »."
msgstr "Notification from the {site_title} shop: “{email_title}”."

